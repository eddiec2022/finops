# PostgreSQL connection used by the backend and Alembic
DATABASE_URL=postgresql://finops:finops@db:5432/finops

# Azure service principal — Cost Management Reader + Reader at subscription scope.
# Read-only. Populated in Task 2 (Azure Resource Graph connector); placeholders only for now.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# AWS IAM user access keys — read-only, per GOV-002 Section 2.1's policy. Optional:
# the app runs Azure-only with these unset. No real account exists yet (Task 19
# builds and tests the AWS connectors against mocked responses only); populated
# once GOV-002 Section 6's account is ready (Task 20).
AWS_ACCOUNT_ID=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
